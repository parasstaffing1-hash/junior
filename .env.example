DATABASE_URL=postgresql+psycopg2://admin:adminpassword@localhost:5432/analytics
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=analytics
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=104857600
BI_REPORT_CACHE_SIZE=3
APP_ENV=development
AUTH_MODE=disabled
ADMIN_API_KEY=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
REQUIRE_TENANT_HEADER=false
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_SECONDS=300
JOB_WORKER_ENABLED=false
JOB_POLL_SECONDS=2
WORKER_ID=local-worker
# Connector and alert credentials are referenced by name; keep actual values
# in the deployment secret manager, never in this file.
# DATA_SOURCE_URL_SALES=<secret-managed SQLAlchemy URL>
# ALERT_WEBHOOK_OPERATIONS=<secret-managed HTTPS webhook URL>
COST_PER_COMPUTE_SECOND=0
COST_CURRENCY=USD
